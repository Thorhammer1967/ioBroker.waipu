{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "main.js",
    "lib/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}